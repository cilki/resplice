#!/usr/bin/env bash

## End-to-end: reimplement a target function in Rust and verify the patched
## binary produces the new result.
##
## Precondition: run `cargo build --release` before invoking attest so the
## `resplice` binary and `resplice-macros` artifacts already exist.

## Scratch directory for everything a case writes: the throwaway target binary
## it patches, and the replacement crate whose `#[Splice]`s are the thing under
## test. It sits under `target/`, so a run leaves the working tree as it found
## it.
##
## That replacement crate used to be `examples/adder`, the crate the README
## points a reader at for a complete example. Each case overwrote it with the
## splice it needed and left it that way, so a run ended with the example
## replaced by whichever scratch crate came last -- the deliberately missized
## data splice, which `resplice` refuses -- and the repository dirty.
fixture=target/splice-fixture

## (Re)create the replacement crate, with no splices in it yet.
##
## It is a crate of its own rather than a member of this workspace: nothing in
## it is checked in, and the `[workspace]` table keeps cargo from insisting that
## a package sitting inside the workspace directory be a member of it. It
## depends on `resplice-macros` by path, as a real reimplementation crate would.
## Sharing the workspace's target directory keeps that dependency built once
## instead of once per case.
newFixture() {
	mkdir -p "$fixture/src"
	rm -f "$fixture/prog" "$fixture/prog.patched" "$fixture/prog.short" \
		"$fixture/prog.bss" "$fixture/prog.lto" "$fixture/err"
	printf '%s\n' '[workspace]' '' '[package]' 'name = "fixture"' \
		'version = "0.0.0"' 'edition = "2024"' 'publish = false' '' \
		'[lib]' 'crate-type = ["rlib"]' '' '[dependencies]' \
		'resplice-macros = { path = "../../resplice-macros" }' \
		> "$fixture/Cargo.toml"
}

## Compile the replacement crate to an rlib. Any arguments are passed on to
## `rustc` for the crate itself.
buildFixture() {
	if [ $# -gt 0 ]; then
		cargo rustc --release --manifest-path "$fixture/Cargo.toml" \
			--target-dir target -- "$@"
	else
		cargo build --release --manifest-path "$fixture/Cargo.toml" \
			--target-dir target
	fi
	[ -f target/release/libfixture.rlib ]
}

## Write `$fixture/compute.s`: a `compute` that returns 41, followed by `$1`
## bytes of slack for the replacement to grow into.
##
## The splice is compiled for the host, so the throwaway target has to be a host
## binary too -- which means this assembly is host-specific. Covering more than
## x86-64 is not pedantry: the injected segment's layout depends on the target's
## page size, and only a non-4K-page host (every aarch64 kernel) exercises that.
writeComputeAsm() {
	local pad=$1 fn_type ret41
	case "$(uname -m)" in
	x86_64 | i?86)
		fn_type='.type compute,@function'
		ret41='mov $41, %eax'
		;;
	aarch64 | arm64)
		fn_type='.type compute,%function'
		ret41='mov w0, #41'
		;;
	*)
		echo "unsupported host architecture $(uname -m)" >&2
		return 1
		;;
	esac
	printf '%s\n' '.text' '.globl compute' "$fn_type" \
		'compute:' "$ret41" 'ret' ".zero $pad" \
		'.size compute, .-compute' > "$fixture/compute.s"
}

## Compile the throwaway target from `$fixture/prog.c` plus any further sources.
## Non-PIE so the addresses below are the ones the loader will use.
buildTarget() {
	cc -fcf-protection=none -no-pie -O2 -o "$fixture/prog" "$fixture/prog.c" "$@"
}

## The same, but position-independent -- which is what `cc` does by default, so
## it is what a reader of the README most likely has in front of them. The
## addresses `symRange` reads are then link-time offsets rather than the ones
## the loader uses, which is exactly the point: see the two PIE cases below.
buildPieTarget() {
	cc -fcf-protection=none -pie -fPIE -O2 -o "$fixture/prog" "$fixture/prog.c" "$@"
}

## The virtual address range of a symbol in the throwaway target, as `va` and
## `end`: `begin`/`end` are virtual addresses, so this reads the symbol's
## `Value` (not its file offset) and the size the symbol table records.
symRange() {
	local name=$1
	va=$(readelf -sW "$fixture/prog" | awk -v n="$name" '$8==n{ print strtonum("0x" $2); exit }')
	size=$(readelf -sW "$fixture/prog" | awk -v n="$name" '$8==n{ print $3; exit }')
	[ -n "$va" ]
	[ -n "$size" ]
	end=$((va + size))
}

## Patch the throwaway target with every splice in the built rlib.
##
## Deliberately no `chmod`: `resplice` reproduces the target's mode on the
## output, so the patched binary runs as it comes out of the tool. `newFixture`
## removes the previous case's `prog.patched`, so this cannot pass on a stale
## file an earlier case left executable.
applySplices() {
	target/release/resplice "$fixture/prog" target/release/libfixture.rlib \
		"$fixture/prog.patched"
	[ -x "$fixture/prog.patched" ]
}

## A self-contained splice (no relocations): the Rust body is a constant, so its
## machine code is patched directly into the target with nothing to resolve.
testSpliceSelfContained() {
	newFixture
	writeComputeAsm 32
	printf '%s\n' '#include <stdio.h>' 'int compute(void);' \
		'int main(void){ printf("%d\n", compute()); return 0; }' > "$fixture/prog.c"
	buildTarget "$fixture/compute.s"

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	printf 'use resplice_macros::Splice;\n#[Splice(begin = %d, end = %d)]\npub extern "C" fn compute() -> i32 { 42 }\n' \
		"$va" "$end" > "$fixture/src/lib.rs"
	buildFixture

	applySplices
	[ "$("$fixture/prog.patched")" = "42" ]
}

## A splice with relocations: the Rust body calls a function the target already
## defines (`helper_c`, bound via the target's symbol table) and reads a Rust
## `static` (its `.rodata` is pulled in by the relocation closure and injected as
## a new segment). Exercises symbol binding + section injection + reloc fixups.
testSpliceResolvesRelocations() {
	newFixture
	# `helper_c` stays a real, out-of-line symbol the splice can bind to; give
	# `compute` generous padding so the larger replacement fits.
	writeComputeAsm 96
	printf '%s\n' '#include <stdio.h>' 'int compute(void);' \
		'int helper_c(int x){ return x + 100; }' \
		'int main(void){ printf("%d\n", compute()); return helper_c(0) * 0; }' > "$fixture/prog.c"
	buildTarget "$fixture/compute.s"

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	# helper_c(1)=101; 101&3=1 -> TABLE[1]=2000; helper_c(7)=107 -> 2107.
	{
		printf 'use resplice_macros::Splice;\n'
		printf 'unsafe extern "C" { fn helper_c(x: i32) -> i32; }\n'
		printf 'static TABLE: [i32; 4] = [1000, 2000, 3000, 4000];\n'
		printf '#[Splice(begin = %d, end = %d)]\n' "$va" "$end"
		printf 'pub extern "C" fn compute() -> i32 {\n'
		printf '    let i = (unsafe { helper_c(1) } & 3) as usize;\n'
		printf '    let a = unsafe { *TABLE.get_unchecked(i) };\n'
		printf '    let b = unsafe { helper_c(7) };\n'
		printf '    a + b\n'
		printf '}\n'
	} > "$fixture/src/lib.rs"
	buildFixture

	applySplices
	[ "$("$fixture/prog.patched")" = "2107" ]
}

## A splice and the helper it calls in different *modules*. rustc compiles a
## crate into one object file per codegen unit, partitioned along module
## boundaries, so the two end up in different members of the rlib and reference
## each other through a symbol that is undefined in the splice's own member --
## only the rest of the archive can resolve it.
##
## `-C codegen-units`/`-C lto=no` pin that split rather than leaving it to
## rustc's size heuristics, which merge the units of a crate this small; a crate
## that reimplements more than a couple of functions is past that threshold on
## its own, as is any `cargo build` (256 units, no cross-unit inlining).
## `-C panic=abort` drops the unwind guard rustc puts on an `extern "C"` fn
## whose body could unwind, which is a call into `core`'s panic machinery --
## not in this rlib, and so not resolvable.
testSpliceResolvesHelperInAnotherCodegenUnit() {
	newFixture
	writeComputeAsm 96
	printf '%s\n' '#include <stdio.h>' 'int compute(int x);' \
		'int main(int argc, char **argv){ (void)argv; printf("%d\n", compute(argc)); return 0; }' > "$fixture/prog.c"
	buildTarget "$fixture/compute.s"

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	# scale(TABLE[1 & 3]) = 2000 * 3 + 1 = 6001.
	{
		printf 'pub mod helper {\n'
		printf '    #[inline(never)]\n'
		printf '    pub fn scale(x: i32) -> i32 { x.wrapping_mul(3).wrapping_add(1) }\n'
		printf '    pub static TABLE: [i32; 4] = [1000, 2000, 3000, 4000];\n'
		printf '}\n'
		printf 'pub mod splices {\n'
		printf '    use crate::helper::{scale, TABLE};\n'
		printf '    use resplice_macros::Splice;\n'
		printf '    #[Splice(begin = %d, end = %d)]\n' "$va" "$end"
		printf '    fn compute(i: i32) -> i32 {\n'
		printf '        scale(unsafe { *TABLE.get_unchecked((i & 3) as usize) })\n'
		printf '    }\n'
		printf '}\n'
	} > "$fixture/src/lib.rs"
	buildFixture -C codegen-units=16 -C lto=no -C panic=abort
	# Guard the premise: without more than one object member there is no
	# cross-member reference left to resolve.
	[ "$(ar t target/release/libfixture.rlib | grep -c '[.]o$')" -gt 1 ]

	applySplices
	[ "$("$fixture/prog.patched")" = "6001" ]
}

## A splice reading an immutable `static` that holds references. rustc emits
## such a static into a `SHF_WRITE` `.data.rel.ro` section, because the pointers
## it contains need relocating -- but it is read-only by the time the program
## runs, and resplice resolves those pointers itself, so it has to be injected
## like any other `.rodata` rather than refused as mutable data.
testSpliceInjectsReferenceHoldingStatic() {
	newFixture
	writeComputeAsm 96
	printf '%s\n' '#include <stdio.h>' 'int compute(int x);' \
		'int main(void){ printf("%d\n", compute(1)); return 0; }' > "$fixture/prog.c"
	buildTarget "$fixture/compute.s"

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	# NAMES[1] is `WXYZ`, whose first byte is 'W' (87). Indexing with a runtime
	# argument keeps the load out of the constant folder, so the splice really
	# does reference NAMES.
	{
		printf 'use resplice_macros::Splice;\n'
		printf 'static A: [u8; 4] = *b"abcd";\n'
		printf 'static B: [u8; 4] = *b"WXYZ";\n'
		printf 'static NAMES: [&[u8; 4]; 2] = [&A, &B];\n'
		printf '#[Splice(begin = %d, end = %d)]\n' "$va" "$end"
		printf 'pub extern "C" fn compute(x: i32) -> i32 {\n'
		printf '    let name = unsafe { *NAMES.get_unchecked((x & 1) as usize) };\n'
		printf '    name[0] as i32\n'
		printf '}\n'
	} > "$fixture/src/lib.rs"
	buildFixture

	applySplices
	[ "$("$fixture/prog.patched")" = "87" ]
}

## A position-independent target, which is what `cc` and every other mainstream
## toolchain produce by default.
##
## The loader maps such an image at a base it picks at run time, so the
## addresses in its headers -- and the `begin`/`end` read out of them -- are
## link-time offsets. Everything resplice resolves is a link-time value, and a
## PC-relative one survives that shift unchanged: the splice, the injected
## segment and the target's own code all move together. So a call into an
## injected helper, a PC-relative load of injected `.rodata` and a call to a
## function the target imports through its PLT all have to work here exactly as
## they do against a fixed-address target.
testSplicePositionIndependentTarget() {
	newFixture
	writeComputeAsm 96
	printf '%s\n' '#include <stdio.h>' 'int compute(int x);' \
		'int helper_c(int x){ return x + 100; }' \
		'int main(int argc, char **argv){ (void)argv; printf("%d\n", compute(argc)); return helper_c(0) * 0; }' > "$fixture/prog.c"
	buildPieTarget "$fixture/compute.s"
	# Guard the premise: a fixed-address target would make this case a
	# duplicate of the ones above.
	readelf -hW "$fixture/prog" | grep -q 'Type:.*DYN'

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	# scale(TABLE[1 & 3]) + helper_c(7) = 2000 * 3 + 1 + 107 = 6108.
	{
		printf 'use resplice_macros::Splice;\n'
		printf 'unsafe extern "C" { fn helper_c(x: i32) -> i32; }\n'
		printf '#[inline(never)]\n'
		printf 'fn scale(x: i32) -> i32 { x.wrapping_mul(3).wrapping_add(1) }\n'
		printf 'static TABLE: [i32; 4] = [1000, 2000, 3000, 4000];\n'
		printf '#[Splice(begin = %d, end = %d)]\n' "$va" "$end"
		printf 'pub extern "C" fn compute(i: i32) -> i32 {\n'
		printf '    let a = scale(unsafe { *TABLE.get_unchecked((i & 3) as usize) });\n'
		printf '    a.wrapping_add(unsafe { helper_c(7) })\n'
		printf '}\n'
	} > "$fixture/src/lib.rs"
	buildFixture

	applySplices
	[ "$("$fixture/prog.patched")" = "6108" ]
}

## The one kind of reference a position-independent target cannot take: an
## absolute address.
##
## `NAMES` is an ordinary immutable `static` holding references, and the pointers
## inside it are `R_AARCH64_ABS64`/`R_X86_64_64` fields. resplice resolves them
## to link-time offsets and there is nothing left to correct them afterwards --
## the dynamic relocations that would have were emitted when the target was
## linked, and resplice adds none -- so the patched binary dereferenced the
## bottom of its address space and died on the first read, reported as a
## successful splice. It has to be refused, and nothing written.
##
## Same splice as `testSpliceInjectsReferenceHoldingStatic`, which still has to
## work against the fixed-address target it uses: what is being refused is the
## combination, not the `static`.
testSpliceRefusesAbsoluteReferenceIntoPieTarget() {
	newFixture
	writeComputeAsm 96
	printf '%s\n' '#include <stdio.h>' 'int compute(int x);' \
		'int main(void){ printf("%d\n", compute(1)); return 0; }' > "$fixture/prog.c"
	buildPieTarget "$fixture/compute.s"
	readelf -hW "$fixture/prog" | grep -q 'Type:.*DYN'

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	{
		printf 'use resplice_macros::Splice;\n'
		printf 'static A: [u8; 4] = *b"abcd";\n'
		printf 'static B: [u8; 4] = *b"WXYZ";\n'
		printf 'static NAMES: [&[u8; 4]; 2] = [&A, &B];\n'
		printf '#[Splice(begin = %d, end = %d)]\n' "$va" "$end"
		printf 'pub extern "C" fn compute(x: i32) -> i32 {\n'
		printf '    let name = unsafe { *NAMES.get_unchecked((x & 1) as usize) };\n'
		printf '    name[0] as i32\n'
		printf '}\n'
	} > "$fixture/src/lib.rs"
	buildFixture

	! target/release/resplice "$fixture/prog" target/release/libfixture.rlib \
		"$fixture/prog.patched"
	[ ! -e "$fixture/prog.patched" ]
}

## An oversized splice: the same relocation-heavy replacement, but the target's
## `compute` is only a few bytes — too small to hold it. The full function is
## relocated into the injected segment and a jump (trampoline) is written at the
## original site. The patched binary must still produce the new result.
testSpliceTrampolinesWhenOversized() {
	newFixture
	# `compute` gets only tiny padding, so its region cannot hold the ~50-byte
	# replacement (but is still big enough for the jump: 5 bytes on x86-64, 4 on
	# aarch64).
	writeComputeAsm 4
	printf '%s\n' '#include <stdio.h>' 'int compute(void);' \
		'int helper_c(int x){ return x + 100; }' \
		'int main(void){ printf("%d\n", compute()); return helper_c(0) * 0; }' > "$fixture/prog.c"
	buildTarget "$fixture/compute.s"

	[ "$("$fixture/prog")" = "41" ]

	symRange compute

	{
		printf 'use resplice_macros::Splice;\n'
		printf 'unsafe extern "C" { fn helper_c(x: i32) -> i32; }\n'
		printf 'static TABLE: [i32; 4] = [1000, 2000, 3000, 4000];\n'
		printf '#[Splice(begin = %d, end = %d)]\n' "$va" "$end"
		printf 'pub extern "C" fn compute() -> i32 {\n'
		printf '    let i = (unsafe { helper_c(1) } & 3) as usize;\n'
		printf '    let a = unsafe { *TABLE.get_unchecked(i) };\n'
		printf '    let b = unsafe { helper_c(7) };\n'
		printf '    a + b\n'
		printf '}\n'
	} > "$fixture/src/lib.rs"
	buildFixture

	applySplices
	[ "$("$fixture/prog.patched")" = "2107" ]
}

## A `#[Splice]` on a `static`: its initializer bytes replace a data range of
## the target byte-for-byte, with no code involved anywhere. The target is plain
## C here -- nothing architecture-specific is needed to put a table in
## `.rodata`.
##
## Also pins down the refusal of a `static` whose size does not match its range.
## A data splice has neither of the escapes `resplice` has for code: relocating
## it into the injected segment leaves a branch instruction where the table
## should be, and filling a short one out leaves NOP *instructions* inside the
## table. Both would otherwise be reported as a successful splice.
testDataSpliceReplacesTableAndRefusesAMissizedOne() {
	newFixture
	# `argc` indexes the table so the read survives constant folding and the
	# patched bytes are what the program actually prints.
	printf '%s\n' '#include <stdio.h>' \
		'const unsigned int prices[4] = { 100, 200, 300, 400 };' \
		'int main(int argc, char **argv){ (void)argv; printf("%u\n", prices[argc & 3]); return 0; }' > "$fixture/prog.c"
	buildTarget

	[ "$("$fixture/prog")" = "200" ]

	symRange prices
	[ "$size" = "16" ]

	# Exact fit: four u32s over the 16-byte range.
	printf 'use resplice_macros::Splice;\n#[Splice(begin = %d, end = %d)]\nstatic PRICES: [u32; 4] = [11, 22, 33, 44];\n' \
		"$va" "$end" > "$fixture/src/lib.rs"
	buildFixture
	applySplices
	[ "$("$fixture/prog.patched")" = "22" ]

	# Half the range: must be refused, and must leave no output behind.
	printf 'use resplice_macros::Splice;\n#[Splice(begin = %d, end = %d)]\nstatic PRICES: [u32; 2] = [11, 22];\n' \
		"$va" "$end" > "$fixture/src/lib.rs"
	buildFixture
	! target/release/resplice "$fixture/prog" target/release/libfixture.rlib \
		"$fixture/prog.short"
	[ ! -e "$fixture/prog.short" ]
}

## A data splice over a *zero-initialized* table has to be refused as the `.bss`
## address it is, not as an unmapped one.
##
## `.bss` is the part of the RW segment that `p_memsz` covers and `p_filesz` does
## not: the loader zeroes it rather than reading it, so the image holds no byte
## at those addresses to replace. They are nonetheless mapped, and `readelf -l`
## says so -- which is why reporting "not mapped by any PT_LOAD segment" was
## worse than no explanation at all. It sent a reader back to a `begin`/`end`
## read straight out of the symbol table, which was right.
testDataSpliceRefusesABssRangeAsBssNotAsUnmapped() {
	newFixture
	printf '%s\n' '#include <stdio.h>' \
		'unsigned int table[4];' \
		'int main(int argc, char **argv){ (void)argv; printf("%u\n", table[argc & 3]); return 0; }' > "$fixture/prog.c"
	buildTarget

	[ "$("$fixture/prog")" = "0" ]

	symRange table
	[ "$size" = "16" ]

	# Confirm the premise: `table` is past the end of its segment's file-backed
	# data, and inside what `p_memsz` maps.
	readelf -lW "$fixture/prog" | awk -v va="$va" '
		$1=="LOAD" {
			base = strtonum($3); filesz = strtonum($5); memsz = strtonum($6)
			if (va >= base + filesz && va < base + memsz) found = 1
		}
		END { exit !found }'

	printf 'use resplice_macros::Splice;\n#[Splice(begin = %d, end = %d)]\nstatic TABLE: [u32; 4] = [11, 22, 33, 44];\n' \
		"$va" "$end" > "$fixture/src/lib.rs"
	buildFixture

	! target/release/resplice "$fixture/prog" target/release/libfixture.rlib \
		"$fixture/prog.bss" 2> "$fixture/err"
	[ ! -e "$fixture/prog.bss" ]
	grep -q '`.bss`' "$fixture/err"
	! grep -q 'not mapped by any PT_LOAD' "$fixture/err"
}

## An rlib built with link-time optimization carries LLVM bitcode instead of
## machine code, and the refusal has to name `lto` in the Cargo profile.
##
## This is the one way a reader gets here: the README already asks them to add
## `panic = "abort"` to `[profile.release]`, and `lto = true` is the next thing
## anyone puts in that table. The message used to blame `-C linker-plugin-lto`
## -- a flag they never passed -- and tell them to use "a plain `cargo build
## --release`", which is exactly the command that produced the rlib.
testRlibBuiltWithLtoIsRefusedNamingTheProfileSetting() {
	newFixture
	writeComputeAsm 32
	printf '%s\n' '#include <stdio.h>' 'int compute(void);' \
		'int main(void){ printf("%d\n", compute()); return 0; }' > "$fixture/prog.c"
	buildTarget "$fixture/compute.s"

	symRange compute
	printf 'use resplice_macros::Splice;\n#[Splice(begin = %d, end = %d)]\npub extern "C" fn compute() -> i32 { 42 }\n' \
		"$va" "$end" > "$fixture/src/lib.rs"

	# The same crate, the same command: without LTO it splices.
	buildFixture
	applySplices
	[ "$("$fixture/prog.patched")" = "42" ]

	# With `lto = true` the rlib holds bitcode, and the refusal has to point at
	# the setting that put it there.
	printf '%s\n' '' '[profile.release]' 'lto = true' >> "$fixture/Cargo.toml"
	buildFixture

	! target/release/resplice "$fixture/prog" target/release/libfixture.rlib \
		"$fixture/prog.lto" 2> "$fixture/err"
	[ ! -e "$fixture/prog.lto" ]
	grep -q 'LLVM bitcode' "$fixture/err"
	grep -q 'lto = false' "$fixture/err"
}
